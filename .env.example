# Cấu hình URL của Backend API cho Frontend:
# - Nếu chạy trên VPS/Docker cùng domain (qua Nginx reverse proxy): để trống hoặc đặt là /api
# - Nếu backend deploy ở domain/server riêng: ví dụ https://api.yourdomain.com/api
# - Mặc định khi chạy npm run dev (nếu không set biến này): http://localhost:3001/api
VITE_API_URL=http://localhost:3001/api
